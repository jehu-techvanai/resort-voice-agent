# Copy to .env and edit. All values are optional.
# DEVICE=cuda               # cuda | cpu (auto-detected if unset)
# STT_MODEL=small           # tiny | base | small | distil-large-v3 ... (keep multilingual for the English gate)
# NON_ENGLISH_THRESHOLD=0.6
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# KNOWLEDGE_FILE=backend/knowledge/resort.md
# LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server: Ollama, llama.cpp server, vLLM
# LLM_MODEL=llama3.2:3b                    # try qwen2.5:3b-instruct, gemma3:4b, phi4-mini
# LLM_MAX_TOKENS=180
# TTS_LANG=a                # a = American, b = British
# TTS_VOICE=af_heart        # e.g. af_bella, am_michael, bf_emma, bm_george
# AGENT_NAME=Maya
# RESORT_NAME=Palm Lagoon Resort
# MOCK=1                    # no models, no GPU: tests the pipeline and UI only

# ---- v0.2
# ADMIN_PASSWORD=choose-one     # settings page password; if unset, a random one is created in data/admin_password.txt
# API_KEYS=key1,key2            # for the API (phase 3); empty = open, local testing only
# MIN_RETRIEVAL_SCORE=0.40      # default for the threshold slider in Settings
# LLM_TIMEOUT=120
# DATA_DIR=./data               # settings, knowledge base versions, unanswered log

# ---- v0.3 speech to text (can also be changed in Settings > Persona)
# STT_ENGINE=whisper-small       # whisper-small | whisper-medium | whisper-large-v3-turbo | sarvam
# SARVAM_API_KEY=                # from dashboard.sarvam.ai; needed for the sarvam engine
# SARVAM_MODEL=saaras:v4
# SARVAM_LANGUAGE=unknown        # unknown = auto-detect (keeps the English-only check working); en-IN forces English
# NON_ENGLISH_THRESHOLD=0.8      # how sure language detection must be before asking the caller to speak English

# ---- v2: session memory + persistence + hybrid RAG
# REDIS_URL=redis://localhost:6379/0     # v2 session memory + hot caches; leave empty to fall back to in-process memory
# SQLITE_DB=./data/v2.db                # v2 durable conversation/contact/analytics store; leave empty to disable
# V2_RAG=1                              # 1 = hybrid BM25 + dense search with RRF; 0 = original dense-only
# V2_RERANK=0                           # 1 = re-rank fused top results with a cross-encoder (slower, more precise)
# V2_RRF_K=60                           # RRF constant k (lower = more punitive to lower ranks)
# V2_TOP_DENSE=8
# V2_TOP_BM25=8
# V2_RERANK_TOP=12
# V2_QUERY_EXPANSION=1                  # expand very short queries with KB headings + synonym map
# V2_SYNONYMS=backend/knowledge/synonyms.json   # optional JSON map: term -> [synonyms]

# =============================================================================
# TWILIO + LIVEKIT VOICE INTEGRATION
# =============================================================================
# These enable inbound phone calls via Twilio and/or LiveKit.
#
# --- Twilio (PSTN phone calls) ---
# 1. Buy a phone number at https://console.twilio.com
# 2. Set up a voice webhook pointing to: https://your-domain.com/twilio/inbound
# 3. Configure these values:
#
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # From Twilio console
TWILIO_AUTH_TOKEN=your_auth_token_here                # From Twilio console
TWILIO_PHONE_NUMBER=+1234567890                       # Your Twilio phone number
#
# --- LiveKit (VoIP / SIP calls) ---
# 1. Create a LiveKit project at https://cloud.livekit.io
# 2. Create API credentials (API Key + Secret)
# 3. For PSTN calls, set up a SIP trunk (optional):
#
LIVEKIT_URL=wss://your-project.livekit.cloud          # LiveKit server URL
LIVEKIT_API_KEY=your_api_key_here                     # From LiveKit dashboard
LIVEKIT_API_SECRET=your_api_secret_here               # From LiveKit dashboard
#
# Optional: SIP trunk for direct PSTN integration
LIVEKIT_SIP_URI=sip:your-trunk.sip.livekit.cloud      # SIP URI from LiveKit
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxxx             # SIP trunk ID
#
# --- Application settings ---
BASE_URL=http://localhost:8000                        # Public URL for webhooks (use ngrok for local dev)
TWILIO_MEDIA_STREAMS=true                             # Use real-time media streaming (lower latency)

# =============================================================================
# END TWILIO + LIVEKIT SECTION
# =============================================================================
